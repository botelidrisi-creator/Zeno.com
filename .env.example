# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Cloud Database configuration (automatically injected via firebase-applet-config.json in AI Studio):
# When deploying to Netlify, provide these environment variables in your Netlify site settings:
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0722695781"
VITE_FIREBASE_API_KEY="AIzaSyD5cpZuNZ6rGJTtZlwHhOJhy-iN3j0L7Vk"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0722695781.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0722695781.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="661077737823"
VITE_FIREBASE_APP_ID="1:661077737823:web:ee1120504e3850971fb6ea"
VITE_FIREBASE_DATABASE_ID="ai-studio-zenocom-adab231d-de88-4aa5-9ac8-85bdd7a26af4"

